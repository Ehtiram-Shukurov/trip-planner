{{page-title "Journal"}}

<div class="card shadow p-3 mb-5">
    <h2 class="text-center mb-4">Date: {{this.model.date}}</h2>
  
    <ul class="list-group">
      {{#each this.model.activities as |activity|}}
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong>{{activity.time}}</strong>
          <span class="text-muted d-block">{{activity.location}}</span>
        </div>
      </li>
      {{/each}}
    </ul>

    <div class="mt-4 text-center">
    </div>
</div>

  <div class="d-flex justify-content-between mt-4">
    <LinkTo @route="memory" @model={{this.model.trip_id}}
    ><button class="btn btn-primary rounded-circle" type="button">
      <i class="bi bi-arrow-left"></i>
    </button>
    </LinkTo>

  </div>



  

{{page-title "Memory"}}
<div>
    <h2 class="text-center"> Location 1</h2>
    <div>
        <CameraGallery/>
    </div>
    <div class="mb-3">
        <textarea class="form-control" id="location_id" rows="5">Journal Entry.....</textarea>
    </div>

    <button class="button is-primary" type="button">Save</button>
</div>
{{outlet}}