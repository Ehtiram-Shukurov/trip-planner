{{page-title "Project2BigChungus"}}
  <nav class="navbar" role="navigation" aria-label="main navigation"  style="background-color:#235725">
    <div id="navbarMenu" class="navbar-menu">
      <div class="navbar-start">
        <h1 class="navbar-item mb-0" style="color:white">My Travel Planner</h1>
        <LinkTo @route="index" class="navbar-item" style="color:white">Home</LinkTo>
      </div>

      <div class="navbar-end">
        <div class="navbar-item">
          {{#if this.auth.user}}
            <button class="button is-light" type="button" {{on "click" this.auth.sign_out}}>
              Log out
            </button>
          {{/if}}
        </div>
      </div>
    </div>
  </nav>

  <main class="flex-grow-1 d-flex align-items-start justify-content-center py-4">
    <div class="container" style="max-width: 900px;">
      {{outlet}}
    </div>
  </main>

  <footer class="bg-dark text-white text-center py-3">
    <p class="mb-0">&copy; 2024 My Travel Planner</p>
  </footer>


  