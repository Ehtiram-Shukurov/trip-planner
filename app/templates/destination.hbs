{{page-title "Destination"}}

<h1>Where do you want to go?</h1>

<div>
  <label for="search">Search for a destination:</label>
  <input id="search" type="text" placeholder="Enter a destination"/>
  <button type="button" {{on "click" this.searchQuery}}>Search</button>
</div>

<div class="map-container">
  <GoogleMapsIframe @query={{this.selectedDestination}} />
</div>

<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="index">
    <button class="btn btn-primary rounded-circle" type="button">
      Cancel
    </button>
  </LinkTo>
  
  <button class="btn btn-primary rounded-circle" type="button" {{on "click" this.validateAndNavigate}}>
    <i class="bi bi-arrow-right"></i>
  </button>
</div>