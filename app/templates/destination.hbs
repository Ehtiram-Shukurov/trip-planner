{{page-title "Destination"}}

<h1 class="title" style="color: black">Where do you want to go?</h1>

<div style="margin-bottom: 5px">
  <input id="search" type="text" placeholder="Enter a country or city"/>
  <button type="button" class="button is-primary" {{on "click" this.searchQuery}}>Search</button>
</div>

<div class="map-container">
  <GoogleMapsIframe @query={{this.selectedDestination}} />
</div>

<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="index">
    <button class="btn btn-primary rounded-circle" type="button" {{on "click" this.cancel}}>
      Cancel
    </button>
  </LinkTo>
  
  <button class="btn btn-primary rounded-circle" type="button" {{on "click" this.validateAndNavigate}}>
    <i class="bi bi-arrow-right"></i>
  </button>
</div>