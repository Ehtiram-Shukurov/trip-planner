{{page-title "Destination"}}
<div class="d-flex flex-column flex-md-row align-items-center mb-4">
  <div class="flex-grow-1 text-center text-md-start mb-3 mb-md-0">
    <h1 class="fs-1 text-dark title mb-3">
      Where<br>
      is your destination?
    </h1>
  </div>
  <div class="flex-grow-1 ms-0 ms-md-2">
    <button 
      class="btn w-100 py-2" 
      type="button" 
      style="background-color: #F1DCA7; color: #000; font-size: 1.25rem; font-weight: bold; transition: transform 0.2s, background-color 0.3s;" 
      {{on "click" this.validateAndNavigate}}>
      <i class="bi bi-arrow-right"></i> Next
    </button>
  </div>
</div>

<div class="map-container animate__animated animate__fadeIn animate__slow" style="border-radius: 10px; overflow: hidden; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);"> 
  <GoogleMapsJs @onPlaceChange={{this.updateDestination}} @searchNearby={{false}}/>
</div>

<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="index">
    <button 
      class="btn btn-primary" 
      type="button" 
      style="font-size: 1rem; padding: 0.5rem 1.5rem;" 
      {{on "click" this.cancel}}>
      Cancel
    </button>
  </LinkTo>
</div>