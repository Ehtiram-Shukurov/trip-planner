{{page-title "Day"}}

<div class="card shadow p-3 mb-5">
  <h2 class="text-center mb-4">Date: {{this.model.date}}</h2>

  <ul class="list-group">
    {{#each this.model.activities as |activity|}}
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong>{{activity.time}}</strong>
          <span class="text-muted d-block">{{activity.location}}</span>
        </div>
        <span class="badge bg-secondary">{{activity.budget}}</span>
      </li>
    {{/each}}
  </ul>

  <div class="mt-4 text-center">
    <button class="btn btn-primary w-100" style="max-width: 300px;" type="button" {{on "click" (fn this.transitionToRoute "addactivity" this.model.date)}}>
  Add Activity +
</button>

  </div>
</div>
