{{page-title "Detail"}}

<div class="card shadow-lg p-4 mb-5" style="border-radius: 10px;">
  <h2 class="text-center mb-4" style="color: #f0e8e8; font-weight: bold;">
    Date: {{this.model.date}}
  </h2>

  <ul class="list-group">
    {{#each this.model.activities as |activity|}}
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <strong style="color: #333;">{{activity.data.time}}</strong>
        <span class="text-muted d-block">{{activity.data.location}}</span>
      </div>
      <span class="badge bg-secondary">${{activity.data.budget}}</span>
      <div class="d-flex gap-2">
        <LinkTo
          @route="editactivity"
          @models={{array this.model.trip_id this.model.date_id activity.id}}
          class="btn btn-outline-secondary btn-sm">
          Edit
        </LinkTo>
        <button
          class="btn btn-outline-danger btn-sm"
          type="button"
          {{on "click" (fn this.deleteActivity activity.id)}}>
          Delete
        </button>
      </div>
    </li>
    {{/each}}
  </ul>

  <div class="mt-4 text-center">
    <LinkTo @route="addactivity" @models={{array this.model.trip_id this.model.date_id}}>
      <button
        class="btn w-100 py-2"
        style="max-width: 300px; background-color: #F1DCA7; color: #000; font-size: 1.1rem; font-weight: bold; transition: background-color 0.3s, transform 0.2s;"
        type="button">
        Add Activity +
      </button>
    </LinkTo>
  </div>
</div>
<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="date" @model={{this.model.trip_id}}>
    <button
      class="btn"
      style="background-color: #F1DCA7; color: #000; font-size: 1.25rem; width: 50px; height: 50px; border-radius: 50%; transition: transform 0.2s, background-color 0.3s;"
      type="button">
      <i class="bi bi-arrow-left"></i>
    </button>
  </LinkTo>
  <LinkTo @route="date" @model={{this.model.trip_id}}>
    <button
      class="btn btn-success rounded-circle d-flex justify-content-center align-items-center"
      style="width: 50px; height: 50px; font-size: 1.5rem; transition: transform 0.2s ease, background-color 0.3s ease;"
      type="button">
      <i class="bi bi-check"></i>
    </button>
  </LinkTo>
</div>
{{outlet}}