{{page-title "Detail"}}

<div class="card shadow p-3 mb-5">
  <h2 class="text-center mb-4">Date: {{this.model.date}}</h2>

  <ul class="list-group">
    {{#each this.model.activities as |activity|}}
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <strong>{{activity.time}}</strong>
        <span class="text-muted d-block">{{activity.location}}</span>
      </div>
      <span class="badge bg-secondary">{{activity.budget}}</span>
    </li>
    {{/each}}
  </ul>

  <div class="mt-4 text-center">

    <LinkTo @route="addactivity" @model={{this.model.date}}>
      <button class="btn btn-primary w-100" style="max-width: 300px;" type="button">
        Add Activity +
      </button>
    </LinkTo>
    
  </div>
</div>
<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="date"
  ><button class="btn btn-primary rounded-circle" type="button">
    <i class="bi bi-arrow-left"></i>
  </button>
  </LinkTo>
  {{!--TODO: make the next button go to the next day if possible. Currently do nothing --}}
    <button class="btn btn-primary rounded-circle" type="button">
      <i class="bi bi-arrow-right"></i>
    </button>
</div>
{{outlet}}