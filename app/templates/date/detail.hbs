{{page-title "Detail"}}

<div class="card shadow p-3 mb-5">
  <h2 class="text-center mb-4">Date: {{this.model.date}}</h2>

  <ul class="list-group">
  {{#each this.model.activities as |activity|}}
  <li class="list-group-item d-flex justify-content-between align-items-center">
    <div>
      <strong style="color: black;">{{activity.data.time}}</strong>
      <span class="text d-block">{{activity.data.location}}</span>
    </div>
    <span class="badge bg-secondary">${{activity.data.budget}}</span>

    <LinkTo
    @route="editactivity"
    @models={{array this.model.trip_id this.model.date_id activity.id}}
    class="btn btn-outline-secondary btn-sm"
  >
    Edit
  </LinkTo>
    <button
      class="btn btn-outline-danger btn-sm" type="button" {{on "click" (fn this.deleteActivity activity.id)}}>
      Delete
    </button>
  </li>
  {{/each}}
  </ul>

  <div class="mt-4 text-center">

    <LinkTo @route="addactivity"  @models={{array this.model.trip_id this.model.date_id}}>
      <button class="btn w-100" style="max-width: 300px; background-color: #F1DCA7; color: #000;" type="button" >
        Add Activity +
      </button>
    </LinkTo>

  </div>
</div>
<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="date" @model={{this.model.trip_id}}>
    <button class="btn w-100" type="button" style="background-color: #F1DCA7; color: #000;">
    <i class="bi bi-arrow-left"></i>
  </button>
  </LinkTo>
  <LinkTo @route="date" @model={{this.model.trip_id}}>
    <button class="btn btn-success rounded-circle" type="button">
      <i class="bi bi-check"></i>
    </button>
  </LinkTo>
</div>
{{outlet}}