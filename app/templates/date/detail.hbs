{{page-title "Detail"}}

<div class="card shadow p-3 mb-5">
  <h2 class="text-center mb-4">Date: {{this.model.date}}</h2>

  <ul class="list-group">

  {{#each this.model.activities as |activity index|}}
    <LinkTo @route="editactivity" @models={{array this.model.trip_id this.model.date_id index}}
      class="text-decoration-none">
      <li class="list-group-item d-flex justify-content-between align-items-center shadow-sm p-3 mb-2 rounded">
        <div class="d-flex flex-column flex-grow-1">
          <div>
            <strong class="text-dark">{{activity.time}}</strong>
            <span class="badge bg-secondary">{{activity.budget}} $</span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">{{activity.location}}</span>
          </div>
        </div>
        <button class="btn btn-outline-danger btn-sm ms-3" type="button" {{on "click" (fn this.deleteActivity index)}}>
          <i class="bi bi-trash"></i> Delete
        </button>
      </li>
    </LinkTo>
  {{/each}}


  </ul>

  <div class="mt-4 text-center">

    <LinkTo @route="addactivity" @models={{array this.model.trip_id this.model.date_id}}>
      <button class="btn btn-primary w-100" style="max-width: 300px;" type="button">
        Add Activity +
      </button>
    </LinkTo>

  </div>
</div>
<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="date" @model={{this.model.trip_id}}>
    <button class="btn btn-primary rounded-circle" type="button">
    <i class="bi bi-arrow-left"></i>
  </button>
  </LinkTo>
  <LinkTo @route="date" @model={{this.model.trip_id}}>
    <button class="btn btn-primary rounded-circle" type="button">
      <i class="bi bi-check"></i>
    </button>
  </LinkTo>
</div>
{{outlet}}