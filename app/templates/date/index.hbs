<div class="container d-flex justify-content-center align-items-center">
  <div class="card shadow-lg w-100" style="max-width: 400px; border-radius: 10px;">
    <div class="card-body text-center">
      <h1 
        class="card-title mb-3" 
        contenteditable="true" 
        id="title" 
        style="font-size: 1.75rem; font-weight: bold; border: 1px dashed transparent; transition: border-color 0.3s ease;" 
        {{on "focusout" this.saveTitle}}
        onfocus="this.style.borderColor='#ccc'"
        onblur="this.style.borderColor='transparent'">
        {{#if this.model.title}}
          {{this.model.title}}
        {{else}}
          Edit Trip Name
        {{/if}}
      </h1>

      <h5 class="card-subtitle mb-4">Destinations</h5>
      <div class="vertical-card-list">
        {{#each this.model.dates as |date|}}
        <div class="carousel-card">
          <LinkTo 
            @route="date.detail"
            @models={{array this.model.trip_id date.id}}
            class="btn btn-light w-100 text-center"
            style="font-size: 1rem; font-weight: 500; padding: 0.75rem; text-transform: capitalize;">
            {{date.date}}
          </LinkTo>
        </div>
        {{/each}}
      </div>

      <div class="d-flex justify-content-end mt-4">
        <button 
          class="btn btn-success rounded-circle d-flex justify-content-center align-items-center" 
          style="width: 50px; height: 50px; font-size: 1.25rem; transition: transform 0.2s ease, background-color 0.3s ease;" 
          type="button" 
          {{on "click" this.saveAndNavigate}}
          onmouseover="this.style.transform='scale(1.1)'; this.style.backgroundColor='#28a745';" 
          onmouseout="this.style.transform='scale(1)'; this.style.backgroundColor='';">
          <i class="bi bi-check"></i>
        </button>
      </div>
    </div>
  </div>
</div>
{{outlet}}