<div {{did-insert this.initializeFields}}>
    <div class="row">
    <div class="col-12 text-center">
      <h1 class="mb-3 title" style="color:black">Edit Activity</h1>
    </div>
  </div>
  <form {{on "submit" this.saveActivity}} class="needs-validation">
    <div class="mb-3">
      <label for="timeInput" class="form-label">Time</label>
      <input
        type="time"
        id="timeInput"
        class="form-control"
        {{on "input" this.updateTime}}
        value={{this.time}}
      />
    </div>
    <div class="mb-3">
      <label for="budgetInput" class="form-label">Budget</label>
      <input
        type="text"
        id="budgetInput"
        class="form-control"
        placeholder="$10"
        {{on "input" this.updateBudget}}
        value={{this.budget}}
      />
    </div>
    <div class="mb-3">
      <label for="locationInput" class="form-label">Location</label>
      <input
        type="text"
        id="locationInput"
        class="form-control"
        placeholder="Enter location"
        {{on "input" this.updateLocation}}
        value={{this.location}}
      />
    </div>
    <button type="submit" class="btn btn-success w-100">Save</button>
  </form>
</div>
