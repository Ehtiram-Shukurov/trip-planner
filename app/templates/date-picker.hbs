{{page-title "DatePicker"}}
<div class="container d-flex justify-content-center align-items-center">
    <div>
        <div style="margin-bottom: 2.5em;">
            <h1>When do you want to go?</h1>
        </div>

        <div class="litepicker-container">
            <Litepicker
                class="custom-litepicker"
                @singleMode={{false}}
                @startDate={{this.today}}
                @plugins={{array 'keyboardnav' 'mobilefriendly'}}
                @numberOfMonths={{if this.isMobile 1 2}}
                @numberOfColumns={{if this.isMobile 1 2}}
                @inlineMode={{true}}
                @registerAPI={{this.registerAPI}}
                @onSelected={{this.onDateChanged}}
                autocomplete='off'
            />
        </div>
    </div>

</div>

<div class="d-flex justify-content-between mt-4">
  <LinkTo @route="destination" @model={{this.model}}>
    <button class="btn btn-primary rounded-circle" type="button">
      <i class="bi bi-arrow-left"></i>
    </button>
  </LinkTo>

  <button class="btn btn-primary rounded-circle" type="button" {{on "click" this.validateAndNavigate}}>
    <i class="bi bi-arrow-right"></i>
  </button>
</div>