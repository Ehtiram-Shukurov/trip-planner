{{yield}}


  <gmpx-api-loader key="AIzaSyCJOJEWNIpSsVDOScXozsAeqV63HmiQwOM" solution-channel="GMP_GE_mapsandplacesautocomplete_v1">
  </gmpx-api-loader>

  <div class="place-picker justify-content-center d-flex mb-3">
    <gmpx-place-picker id="search" placeholder="Enter an address"></gmpx-place-picker>
  </div>

  <gmp-map style="height: 500px; width: 100%" center="40.749933,-73.98633" zoom="13" map-id="DEMO_MAP_ID" {{did-insert
    this.initMap}}>
    <gmp-advanced-marker></gmp-advanced-marker>
  </gmp-map>

<div class="suggestion">
  {{#if this.search}}
  {{#if this.selectedLocation}}
  <div class="mt-3">
    <!-- Primary button for suggestions -->
    <button class="btn btn-primary mb-3" type="button" {{on "click" this.searchNearby}}>
      Want some suggestions?
    </button>
  </div>

  <!-- Places List -->
  {{#if this.places.length}}
  <ul class="list-group">
    {{#each this.places as |place|}}
    {{log place}}
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <!-- Place Name -->
      <span class="fw-bold">{{place.displayName}}</span>

      <!-- Actions -->
      <div>
        <button class="btn btn-link btn-sm text-primary" type="button" {{on "click" (fn this.centerMapOnPlace place)}}>
          Center on Map
        </button>
        <button class="btn btn-link btn-sm text-success" type="button" {{on "click" (fn this.pickLocation place)}}>
          Pick it!
        </button>
      </div>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="mt-2 text-muted">
    <i class="bi bi-info-circle"></i> No nearby places found.
  </p>
  {{/if}}
  {{/if}}
  {{/if}}
</div>
